---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist.">
  <div class="max-w-[760px] mx-auto px-5 sm:px-8 py-20 text-center">
    <div class="mono text-xs acc2">// 404</div>
    <h1 class="serif text-4xl font-semibold mt-2 text-fg">Page not found</h1>
    <p class="muted mt-3">That URL doesn't exist (or moved).</p>
    <a href="/" class="accbg rounded-md px-4 py-2 text-sm font-medium inline-block mt-6">Back home</a>
  </div>
</BaseLayout>
