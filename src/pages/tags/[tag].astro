---
import PageLayout from '@/layouts/PageLayout.astro';
import PostList from '@/components/PostList.astro';
import { getPublishedPosts, slugify } from '@/lib/utils';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = new Set<string>();
  for (const p of posts) for (const t of p.data.tags) tags.add(t);
  return [...tags].map((tag) => ({ params: { tag: slugify(tag) }, props: { tag } }));
}

const { tag } = Astro.props;
const posts = (await getPublishedPosts()).filter((p) =>
  (p.data.tags as string[]).includes(tag),
);
---

<PageLayout
  title={`Tag: #${tag}`}
  description={`Posts tagged ${tag}.`}
  eyebrow="tag"
  prose={false}
  wide={true}
  subnav="writing"
>
  <PostList posts={posts} />
  <p class="mt-6 text-sm"><a href="/tags/" class="acc hover:underline">← All tags</a></p>
</PageLayout>
