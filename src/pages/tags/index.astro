---
import PageLayout from '@/layouts/PageLayout.astro';
import { getPublishedPosts, slugify } from '@/lib/utils';

const posts = await getPublishedPosts();
const counts = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<PageLayout
  title="Tags"
  description="Browse posts by tag."
  eyebrow="tags"
  prose={false}
  wide={true}
  subnav="writing"
>
  <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
    {
      tags.map(([tag, count]) => (
        <li>
          <a
            href={`/tags/${slugify(tag)}/`}
            class="card rounded-xl px-4 py-3 flex items-center justify-between gap-3 hover:border-[var(--accent)] transition-colors group"
          >
            <span class="mono text-sm font-medium text-fg group-hover:text-[var(--accent)] transition-colors">
              #{tag}
            </span>
            <span class="mono text-xs muted shrink-0">
              {count} {count === 1 ? 'post' : 'posts'}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</PageLayout>
