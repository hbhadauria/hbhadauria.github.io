---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const projects = (await getCollection('projects')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order,
);

const featuredProject = projects[0];
const latestPosts = posts.slice(0, 3);
const latestPostUrl = latestPosts[0] ? `/posts/${latestPosts[0].id}/` : '/archives/';

const featuredCover =
  featuredProject?.id === 'calchub'
    ? {
        src: '/images/calchub/v3-1-banner.png',
        badge: 'v3.1 COMING SOON',
      }
    : undefined;

const blueprintGlows = [
  'background: radial-gradient(circle at 86% 18%, rgba(99, 102, 241, 0.16), transparent 65%);',
  'background: radial-gradient(circle at 86% 18%, rgba(16, 185, 129, 0.14), transparent 65%);',
  'background: radial-gradient(circle at 86% 18%, rgba(14, 165, 233, 0.15), transparent 65%);',
];
---

<BaseLayout title={SITE.brandTitle} description={SITE.description}>
  <!-- Architect Hero + Terminal Card -->
  <section class="grid-bg">
    <div
      class="max-w-[1140px] mx-auto px-5 sm:px-8 py-12 lg:py-14 grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] gap-8 lg:gap-10 items-center"
      style="background: linear-gradient(90deg, var(--bg) 55%, transparent);"
    >
      <div class="min-w-0">
        <div class="mono text-xs acc2">
          // designing scalable systems · shipping faster with AI
        </div>
        <h1 class="serif text-3xl sm:text-[42px] leading-[1.12] font-bold mt-3 text-fg">
          I design scalable systems, then ship them faster with{' '}
          <span class="acc">AI</span>.
        </h1>
        <p class="muted mt-4 text-[15px] leading-7 max-w-xl">
          Field notes on system architecture, cloud-native patterns and
          AI-assisted delivery, plus the projects behind them.
        </p>
        <div class="flex flex-wrap gap-3 mt-6 text-sm">
          <a
            href={latestPostUrl}
            class="accbg rounded-md px-4 py-2 font-medium hover:opacity-90 transition-opacity"
          >
            Read the latest →
          </a>
          <a
            href="/projects/"
            class="card rounded-md px-4 py-2 hover:border-[var(--accent)] transition-colors"
          >
            See projects
          </a>
          <a
            href="/feed.xml"
            class="card rounded-md px-4 py-2 mono hover:border-[var(--accent)] transition-colors"
          >
            RSS
          </a>
        </div>
      </div>

      <div
        class="min-w-0 rounded-2xl overflow-hidden border bd shadow-2xl"
        style="background: var(--code);"
        aria-label="Architect profile summary"
      >
        <div class="flex items-center justify-between px-4 py-2.5 border-b border-white/10 bg-white/[0.03]">
          <div class="flex items-center gap-1.5" aria-hidden="true">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-400/75" />
            <span class="w-2.5 h-2.5 rounded-full bg-amber-400/75" />
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400/75" />
          </div>
          <span class="mono text-[11px] text-[#8b949e]">whoami --json</span>
        </div>
        <pre
          class="mono m-0! border-0! rounded-none! bg-transparent! whitespace-pre-wrap break-words text-xs leading-relaxed p-4"
        ><span style="color:#8b949e">$</span> whoami --json
{`{`}
  <span style="color:#a5d6ff">"role"</span>:    <span style="color:#a5d6ff">"Tech Solution Architect"</span>,
  <span style="color:#a5d6ff">"focus"</span>:   [<span style="color:#a5d6ff">"Architecture"</span>, <span style="color:#a5d6ff">"Cloud"</span>, <span style="color:#a5d6ff">"Distributed Systems"</span>],
  <span style="color:#a5d6ff">"ai"</span>:      [<span style="color:#a5d6ff">"Gemini"</span>, <span style="color:#a5d6ff">"Claude"</span>, <span style="color:#a5d6ff">"Copilot"</span>],
  <span style="color:#a5d6ff">"shipped"</span>: <span style="color:#d2a8ff">"CalcHub v3.0 · Play Store"</span>
{`}`}</pre>
      </div>
    </div>
  </section>

  <!-- Featured Project -->
  <section class="max-w-[1140px] mx-auto px-5 sm:px-8 py-8 border-t bd">
    <div class="flex justify-between items-baseline">
      <h2 class="font-semibold text-lg text-fg">Featured project</h2>
      <a href="/projects/" class="text-sm acc hover:underline">
        All projects →
      </a>
    </div>

    {
      featuredProject ? (
        <div class="card rounded-2xl overflow-hidden mt-4 grid grid-cols-1 md:grid-cols-[1.05fr_1.15fr]">
          {featuredCover ? (
            <div class="min-h-[240px] relative overflow-hidden flex flex-col justify-between" style="background: linear-gradient(135deg, #052e2b 0%, #0b1320 45%, #1e1b4b 100%);">
              <img src={featuredCover.src} alt="CalcHub v3.1.0 Expressive Aurora financial calculators showcase" class="absolute inset-0 w-full h-full object-contain" loading="eager" />
              <div
                aria-hidden="true"
                class="absolute inset-0 bg-gradient-to-t from-[#0b0d12]/75 via-transparent to-[#0b0d12]/45 pointer-events-none"
              />
              <div class="relative z-10 flex items-center justify-between gap-2 p-3.5">
                <span class="text-[11px] mono bg-black/60 backdrop-blur-sm text-white border border-white/15 rounded px-2 py-0.5">
                  CASE STUDY
                </span>
                <span class="text-[11px] mono bg-emerald-500/20 backdrop-blur-sm text-emerald-300 border border-emerald-400/30 rounded px-2 py-0.5">
                  {featuredProject.data.status.toUpperCase()}
                  {featuredCover.badge ? ` · ${featuredCover.badge}` : ''}
                </span>
              </div>
              <div class="relative z-10 flex flex-wrap gap-1.5 px-3.5 pb-3 pt-10">
                {featuredProject.data.tags.slice(0, 4).map((tag) => (
                  <span class="text-[11px] mono bg-black/55 backdrop-blur-sm text-slate-200 border border-white/15 rounded-full px-2.5 py-0.5">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          ) : (
            <div class="min-h-[220px] relative overflow-hidden flex flex-col justify-between p-4 grid-bg soft border-b md:border-b-0 md:border-r bd">
              <div
                aria-hidden="true"
                class="absolute inset-0 pointer-events-none"
                style="background: radial-gradient(circle at 85% 20%, rgba(16, 185, 129, 0.16), transparent 65%);"
              />
              <div class="relative z-10 flex items-center justify-between gap-2">
                <span class="text-[11px] mono card rounded px-2 py-0.5 text-fg">
                  CASE STUDY
                </span>
                <span class="text-[11px] mono acc2">
                  {featuredProject.data.status.toUpperCase()}
                </span>
              </div>
              <div class="relative z-10">
                <div class="mono text-xs acc2">{featuredProject.data.category}</div>
                <div class="serif text-2xl font-semibold text-fg mt-1">
                  {featuredProject.data.title}
                </div>
                <div class="text-xs muted mt-1">{featuredProject.data.tagline}</div>
              </div>
              <div class="relative z-10 flex flex-wrap gap-1.5">
                {featuredProject.data.tags.slice(0, 4).map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          )}
          <div class="p-6 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2">
                <span class="mono text-[11px] acc2 uppercase tracking-wide">
                  {featuredProject.data.tagline}
                </span>
                <span class="mono text-[11px] muted">
                  {featuredProject.data.category}
                </span>
              </div>
              <h3 class="text-xl font-semibold text-fg mt-1">
                {featuredProject.data.title}
              </h3>
              <p class="muted text-sm mt-2 leading-relaxed">
                {featuredProject.data.description}
              </p>
              {featuredProject.data.metrics && featuredProject.data.metrics.length > 0 && (
                <div class="grid grid-cols-3 gap-2 mt-4 text-center">
                  {featuredProject.data.metrics.slice(0, 3).map((m) => (
                    <div class="soft rounded-lg py-2 px-2">
                      <div class="font-bold acc">{m.value}</div>
                      <div class="text-[11px] muted leading-tight mt-0.5">{m.label}</div>
                    </div>
                  ))}
                </div>
              )}
            </div>
            <div class="flex flex-wrap gap-2 mt-5 text-sm">
              <a
                href={`/projects/${featuredProject.id}/`}
                class="accbg rounded-md px-3.5 py-1.5 font-medium hover:opacity-90 transition-opacity"
              >
                Read story →
              </a>
              {featuredProject.data.links?.playStore && (
                <a
                  href={featuredProject.data.links.playStore}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="card rounded-md px-3.5 py-1.5 hover:border-[var(--accent)] transition-colors"
                >
                  Google Play ↗
                </a>
              )}
              {featuredProject.data.links?.github && (
                <a
                  href={featuredProject.data.links.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="card rounded-md px-3.5 py-1.5 hover:border-[var(--accent)] transition-colors"
                >
                  GitHub ↗
                </a>
              )}
            </div>
          </div>
        </div>
      ) : (
        <div class="card rounded-2xl p-6 mt-4 text-sm muted">
          No featured project configured yet. Add entries under{' '}
          <code class="mono">src/content/projects/</code>.
        </div>
      )
    }
  </section>

  <!-- Latest Writing -->
  <section class="max-w-[1140px] mx-auto px-5 sm:px-8 py-8 border-t bd">
    <div class="flex justify-between items-baseline">
      <h2 class="font-semibold text-lg text-fg">Latest writing</h2>
      <a href="/archives/" class="text-sm acc hover:underline">
        All posts →
      </a>
    </div>

    {
      latestPosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-4">
          {latestPosts.map((post, idx) => (
            <article class="card rounded-xl overflow-hidden flex flex-col hover:border-[var(--accent)] transition-colors">
              <a href={`/posts/${post.id}/`} class="flex flex-col flex-1">
                <div class="h-28 relative overflow-hidden p-4 flex flex-col justify-between border-b bd grid-bg soft">
                  <div
                    aria-hidden="true"
                    class="absolute inset-0 pointer-events-none"
                    style={blueprintGlows[idx % blueprintGlows.length]}
                  />
                  <div class="flex items-center justify-between gap-2 text-[11px] mono relative z-10">
                    <span class="rounded-full px-2 py-0.5 font-medium border bd card text-fg">
                      {post.data.series
                        ? `SERIES · PART ${post.data.seriesOrder ?? 1}`
                        : post.data.categories.join(' · ').toUpperCase()}
                    </span>
                    {post.data.readingTime && (
                      <span class="muted">{post.data.readingTime}</span>
                    )}
                  </div>
                  <div class="flex items-end justify-between gap-2 relative z-10">
                    <div class="mono text-[11px] muted truncate">
                      {post.data.tags.slice(0, 3).map((t) => `#${t}`).join(' · ')}
                    </div>
                    <span class="serif text-2xl font-bold leading-none select-none opacity-25 acc">
                      {String(idx + 1).padStart(2, '0')}
                    </span>
                  </div>
                </div>
                <div class="p-4 flex-1 flex flex-col justify-between">
                  <div>
                    <div class="mono text-[11px] muted">
                      {post.data.pubDate.toISOString().slice(0, 10)}
                    </div>
                    <h3 class="font-semibold mt-1.5 leading-snug text-fg">
                      {post.data.title}
                    </h3>
                    <p class="muted text-xs mt-2 line-clamp-2">
                      {post.data.description}
                    </p>
                  </div>
                  <div class="flex flex-wrap gap-1.5 mt-3">
                    {post.data.categories.map((cat) => (
                      <span class="tag">{cat}</span>
                    ))}
                  </div>
                </div>
              </a>
            </article>
          ))}
          {latestPosts.length === 2 && (
            <article class="card rounded-xl overflow-hidden flex flex-col border-dashed hover:border-[var(--accent)] transition-colors">
              <a href="/projects/calchub/" class="flex flex-col flex-1">
                <div class="h-28 relative overflow-hidden p-4 flex flex-col justify-between border-b bd grid-bg soft">
                  <div
                    aria-hidden="true"
                    class="absolute inset-0 pointer-events-none"
                    style={blueprintGlows[2]}
                  />
                  <div class="flex items-center justify-between gap-2 text-[11px] mono relative z-10">
                    <span class="rounded-full px-2 py-0.5 font-medium border bd card acc2">
                      UP NEXT · PART 2
                    </span>
                    <span class="muted">Case study live</span>
                  </div>
                  <div class="flex items-end justify-between gap-2 relative z-10">
                    <div class="mono text-[11px] muted truncate">
                      #android · #navigation-3 · #ai
                    </div>
                    <span class="serif text-2xl font-bold leading-none select-none opacity-25 acc">
                      03
                    </span>
                  </div>
                </div>
                <div class="p-4 flex-1 flex flex-col justify-between">
                  <div>
                    <div class="mono text-[11px] muted">
                      SERIES · AI-ASSISTED ENGINEERING
                    </div>
                    <h3 class="font-semibold mt-1.5 leading-snug text-fg">
                      CalcHub v3.0: Redesigning an Android App with AI &amp; Quality Gates
                    </h3>
                    <p class="muted text-xs mt-2 line-clamp-2">
                      Expressive Aurora, Navigation 3, a 35-line AppContainer, and hardware-verified CI — explore the live case study while Part 2 is finalized.
                    </p>
                  </div>
                  <div class="flex items-center justify-between gap-2 mt-3">
                    <div class="flex flex-wrap gap-1.5">
                      <span class="tag">Apps</span>
                      <span class="tag">AI</span>
                    </div>
                    <span class="text-xs acc font-medium">Case study →</span>
                  </div>
                </div>
              </a>
            </article>
          )}
        </div>
      ) : (
        <div class="card rounded-xl p-6 mt-4 text-sm muted">
          No published posts yet. Add markdown or MDX posts under{' '}
          <code class="mono">src/content/blog/</code>.
        </div>
      )
    }
  </section>

  <!-- Topics Bar -->
  <section class="max-w-[1140px] mx-auto px-5 sm:px-8 py-6 border-t bd flex flex-wrap gap-2 text-sm items-center">
    <span class="muted mr-2 mono text-xs">TOPICS</span>
    {
      SITE.topics.map((topic) => (
        <a
          href={topic.href}
          class="tag hover:border-[var(--accent)] hover:text-fg transition-colors"
        >
          <span>{topic.icon}</span>
          <span>{topic.label}</span>
        </a>
      ))
    }
  </section>
</BaseLayout>
