---
import { getCollection } from 'astro:content';
import ProjectsLayout from '@/layouts/ProjectsLayout.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order,
);
const capabilities = [
  {
    eyebrow: '01 · ARCHITECTURE & CLOUD',
    title: 'Distributed Systems',
    items: ['C# / .NET', 'Microservices', 'Event-Driven', 'Azure', 'AWS', 'Docker', 'Kubernetes', 'Dapr'],
  },
  {
    eyebrow: '02 · MOBILE & WEB',
    title: 'Product Engineering',
    items: ['Kotlin', 'Jetpack Compose', 'Navigation 3', 'MAUI', 'TypeScript', 'Astro', 'Tailwind CSS'],
  },
  {
    eyebrow: '03 · AI & DELIVERY',
    title: 'AI Engineering & CI/CD',
    items: ['Gemini', 'Claude', 'Copilot', 'Antigravity', 'GitHub Actions', 'Azure DevOps', 'Automated Tests'],
  },
];
---

<ProjectsLayout
  title="Things I've built"
  description="Shipped apps and experiments, each with the story behind it."
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    {
      projects.map((p) => {
        const isSingle = projects.length === 1;
        const hasCalcHubCover = p.id === 'calchub';
        return (
          <article
            class={`card rounded-2xl overflow-hidden hover:border-[var(--accent)] transition-colors ${
              isSingle ? 'md:col-span-2 grid grid-cols-1 md:grid-cols-[1.25fr_1fr]' : 'flex flex-col'
            }`}
          >
            <a
              href={`/projects/${p.id}/`}
              class={`block relative overflow-hidden ${isSingle ? 'min-h-[250px]' : 'h-48'}`}
              style="background: linear-gradient(135deg, #052e2b 0%, #0b1320 45%, #1e1b4b 100%);"
            >
              {hasCalcHubCover ? (
                <img src="/images/calchub/v3-banner.png" alt="CalcHub v3.0.0 Expressive Aurora showcase" class="absolute inset-0 w-full h-full object-contain" loading="eager" />
              ) : (
                <div
                  class="absolute inset-0 grid-bg soft"
                  style={
                    p.data.gradient
                      ? `background: ${p.data.gradient};`
                      : 'background: linear-gradient(135deg, #064e3b 0%, #0f172a 50%, #312e81 100%);'
                  }
                />
              )}
              <div
                aria-hidden="true"
                class="absolute inset-0 bg-gradient-to-t from-[#0b0d12]/70 via-transparent to-[#0b0d12]/45 pointer-events-none"
              />
              <div class="relative z-10 flex items-center justify-between gap-2 p-4">
                <span class="text-[11px] mono bg-black/60 backdrop-blur-sm text-white border border-white/15 rounded px-2 py-0.5">
                  CASE STUDY · {p.data.category.toUpperCase()}
                </span>
                <span class="text-[11px] mono bg-emerald-500/20 backdrop-blur-sm text-emerald-300 border border-emerald-400/30 rounded px-2 py-0.5">
                  {p.data.status.toUpperCase()}
                  {hasCalcHubCover ? ' · v3.0' : ''}
                </span>
              </div>
            </a>

            <div class="p-6 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between gap-2">
                  <span class="mono text-[11px] acc2 uppercase tracking-wide">
                    {p.data.tagline}
                  </span>
                  <span class="tag acc2">{p.data.status}</span>
                </div>
                <h2 class="font-semibold text-xl text-fg mt-1">
                  <a href={`/projects/${p.id}/`} class="hover:text-[var(--accent)] transition-colors">
                    {p.data.title}
                  </a>
                </h2>
                <p class="muted text-sm mt-2 leading-relaxed">{p.data.description}</p>

                {p.data.metrics && p.data.metrics.length > 0 && (
                  <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-4 text-center">
                    {p.data.metrics.slice(0, 4).map((m) => (
                      <div class="soft rounded-lg py-2 px-2">
                        <div class="font-bold acc text-sm sm:text-base">{m.value}</div>
                        <div class="text-[11px] muted leading-tight mt-0.5">{m.label}</div>
                      </div>
                    ))}
                  </div>
                )}

                <div class="flex flex-wrap gap-1.5 mt-4">
                  {p.data.tags.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </div>
              </div>

              <div class="flex flex-wrap gap-2 mt-5 pt-4 border-t bd text-xs font-medium">
                <a
                  href={`/projects/${p.id}/`}
                  class="accbg rounded-md px-3.5 py-1.5 hover:opacity-90 transition-opacity"
                >
                  Case study →
                </a>
                {p.data.links?.playStore && (
                  <a
                    href={p.data.links.playStore}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="card rounded-md px-3.5 py-1.5 hover:border-[var(--accent)] transition-colors"
                  >
                    Google Play ↗
                  </a>
                )}
                {p.data.links?.github && (
                  <a
                    href={p.data.links.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="card rounded-md px-3.5 py-1.5 hover:border-[var(--accent)] transition-colors"
                  >
                    GitHub ↗
                  </a>
                )}
              </div>
            </div>
          </article>
        );
      })
    }
  </div>

  <section class="mt-10 pt-8 border-t bd">
    <div class="flex items-baseline justify-between gap-4">
      <div>
        <div class="mono text-xs acc2">// capabilities</div>
        <h2 class="serif text-2xl font-semibold text-fg mt-1">
          Skills at a glance
        </h2>
      </div>
      <a href="/about/" class="text-sm acc hover:underline">
        Full toolbelt →
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-5">
      {
        capabilities.map((cap) => (
          <div class="card rounded-2xl p-5">
            <div class="mono text-[11px] acc2">{cap.eyebrow}</div>
            <h3 class="font-semibold text-base text-fg mt-1">{cap.title}</h3>
            <div class="flex flex-wrap gap-1.5 mt-3.5">
              {cap.items.map((item) => (
                <span class="tag">{item}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</ProjectsLayout>
