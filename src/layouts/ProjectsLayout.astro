---
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Metric {
  value: string;
  label: string;
}

interface ProjectLinks {
  playStore?: string;
  github?: string;
  demo?: string;
}

interface Props {
  title: string;
  tagline?: string;
  description: string;
  status?: string;
  gradient?: string;
  metrics?: Metric[];
  tags?: string[];
  links?: ProjectLinks;
  ogImage?: string;
  isCaseStudy?: boolean;
}

const {
  title,
  tagline,
  description,
  status,
  gradient = 'linear-gradient(135deg, #064e3b 0%, #0f172a 50%, #312e81 100%)',
  metrics = [],
  tags = [],
  links,
  ogImage,
  isCaseStudy = false,
} = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  {
    isCaseStudy ? (
      <div class="max-w-[1140px] mx-auto px-5 sm:px-8 py-10">
        <article class="max-w-4xl mx-auto" data-pagefind-body>
          <div class="mb-6">
            <a href="/projects/" class="mono text-xs muted hover:text-fg">
              ← All projects
            </a>
          </div>

          <div class="card rounded-2xl overflow-hidden mb-8">
            <div
              class="h-44 sm:h-52 relative flex items-end p-6 overflow-hidden"
              style={`background: ${gradient};`}
            >
              <div
                aria-hidden="true"
                class="absolute inset-0 opacity-20 pointer-events-none"
                style="background-image: linear-gradient(rgba(255,255,255,0.22) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.22) 1px, transparent 1px); background-size: 28px 28px;"
              />
              {status && (
                <span class="absolute z-10 top-4 left-4 text-[11px] mono bg-black/50 backdrop-blur-sm border border-white/15 text-white rounded px-2.5 py-1">
                  {status.toUpperCase()}
                </span>
              )}
              <div class="relative z-10 text-white drop-shadow">
                {tagline && (
                  <p class="mono text-xs uppercase tracking-wider opacity-90">
                    {tagline}
                  </p>
                )}
                <h1 class="serif text-3xl sm:text-4xl font-semibold mt-1">
                  {title}
                </h1>
              </div>
            </div>

            <div class="p-6 space-y-5">
              <p class="muted text-base leading-relaxed">{description}</p>

              {metrics.length > 0 && (
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
                  {metrics.map((m) => (
                    <div class="soft rounded-lg py-2.5 px-3">
                      <div class="font-bold acc text-lg">{m.value}</div>
                      <div class="text-[11px] muted mt-0.5">{m.label}</div>
                    </div>
                  ))}
                </div>
              )}

              <div class="flex flex-wrap items-center justify-between gap-4 pt-2 border-t bd">
                {tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}

                {links && (
                  <div class="flex flex-wrap gap-2 text-xs font-medium">
                    {links.playStore && (
                      <a
                        href={links.playStore}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="accbg rounded-md px-3.5 py-2 hover:opacity-90 transition-opacity"
                      >
                        Google Play ↗
                      </a>
                    )}
                    {links.github && (
                      <a
                        href={links.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="card rounded-md px-3.5 py-2 hover:border-[var(--accent)] transition-colors"
                      >
                        Source on GitHub ↗
                      </a>
                    )}
                    {links.demo && (
                      <a
                        href={links.demo}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="card rounded-md px-3.5 py-2 hover:border-[var(--accent)] transition-colors"
                      >
                        Live Demo ↗
                      </a>
                    )}
                  </div>
                )}
              </div>
            </div>
          </div>

          <div class="prose prose-ep max-w-none">
            <slot />
          </div>
        </article>
      </div>
    ) : (
      <div>
        <section class="grid-bg border-b bd">
          <div
            class="max-w-[1140px] mx-auto px-5 sm:px-8 py-9 sm:py-11"
            style="background: linear-gradient(90deg, var(--bg) 55%, transparent);"
          >
            <header>
              <div class="mono text-xs acc2">// projects</div>
              <h1 class="serif text-3xl sm:text-4xl font-semibold mt-2 text-fg">
                {title}
              </h1>
              <p class="muted mt-2.5 max-w-2xl text-sm sm:text-base leading-relaxed">
                {description}
              </p>
            </header>
          </div>
        </section>
        <div class="max-w-[1140px] mx-auto px-5 sm:px-8 py-8 sm:py-10">
          <slot />
        </div>
      </div>
    )
  }
</BaseLayout>
