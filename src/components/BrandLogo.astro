---
interface Props {
  size?: number;
  showWordmark?: boolean;
}

const { size = 30, showWordmark = true } = Astro.props;
---

<span class="inline-flex items-center gap-2.5 shrink-0">
  <svg
    width={size}
    height={size}
    viewBox="0 0 64 64"
    aria-hidden="true"
    class="shrink-0 rounded-[7px]"
  >
    <rect width="64" height="64" rx="14" fill="#0f1117"></rect>
    <path
      d="M18 15v34M46 15v34"
      stroke="#f8fafc"
      stroke-width="6"
      stroke-linecap="round"></path>
    <path
      d="M32 21l3.2 7.8L43 32l-7.8 3.2L32 43l-3.2-7.8L21 32l7.8-3.2z"
      fill="#34d399"></path>
  </svg>
  {
    showWordmark && (
      <span class="leading-tight">
        <span class="font-semibold text-sm block text-fg">Harshit Bhadauria</span>
        <span class="mono text-[10px] muted block tracking-wider uppercase">
          HSB LEARNINGS
        </span>
      </span>
    )
  }
</span>
