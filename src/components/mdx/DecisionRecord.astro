---
interface Props {
  id: string;
  title: string;
  decision?: string;
  status?: 'Locked' | 'Accepted' | 'Superseded' | 'Proposed';
}

const { id, title, decision, status = 'Locked' } = Astro.props;
---

<div
  class="my-6 rounded-xl card p-4 space-y-2 text-[14px] not-prose"
  style="border-left: 4px solid var(--accent);"
>
  <div class="flex items-center justify-between gap-2 flex-wrap">
    <span class="mono text-xs font-bold acc uppercase tracking-wide">
      {id} · {title}
    </span>
    <span class="tag mono text-[11px] acc2 font-medium">{status}</span>
  </div>
  {decision && <p class="font-semibold text-fg leading-snug">{decision}</p>}
  <div class="muted text-[13.5px] leading-relaxed">
    <slot />
  </div>
</div>
